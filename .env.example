# FORGE configuration.
#
# Every variable below is read by config.Load(), which validates them at startup
# and refuses to boot on a bad value rather than defaulting to something that
# looks like it works. Copy to .env and fill in.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# development | test | production
# Production forbids the file mail transport, plaintext PUBLIC_URL, and
# insecure cookies. Those are refused, not warned about.
FORGE_ENV=development

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
FORGE_HTTP_ADDR=:8080
# Verification and password-reset links are built from this. A wrong value
# produces mail whose links resolve nowhere.
FORGE_PUBLIC_URL=http://localhost:8080
FORGE_HTTP_READ_TIMEOUT=30s
FORGE_HTTP_WRITE_TIMEOUT=5m
FORGE_HTTP_SHUTDOWN_GRACE=20s
FORGE_HTTP_MAX_BODY_BYTES=4194304

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
FORGE_DATABASE_URL=postgres://forge:forge_dev_pw@localhost:55840/forge?sslmode=disable
FORGE_DB_MAX_CONNS=16
FORGE_DB_MIN_CONNS=2
FORGE_DB_CONN_LIFETIME=1h
FORGE_DB_CONN_IDLE=30m
FORGE_DB_CONNECT_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
FORGE_LOG_LEVEL=info      # debug | info | warn | error
FORGE_LOG_FORMAT=text     # text for humans, json for machines (prod default)

# ---------------------------------------------------------------------------
# Mail — used by email verification and password reset
# ---------------------------------------------------------------------------
# file   : writes .eml files to FORGE_MAIL_OUTBOX_DIR. Development only; the
#          config loader refuses it in production because it does not deliver.
# resend : delivers via the Resend HTTP API. Needs RESEND_API_KEY.
# smtp   : delivers via SMTP+STARTTLS. Needs FORGE_SMTP_HOST.
FORGE_MAIL_TRANSPORT=file
FORGE_MAIL_FROM_NAME=FORGE
FORGE_MAIL_FROM_EMAIL=forge@localhost
FORGE_MAIL_OUTBOX_DIR=./.forge/outbox
FORGE_MAIL_SEND_TIMEOUT=20s
# RESEND_API_KEY=
# FORGE_SMTP_HOST=
# FORGE_SMTP_PORT=587
# FORGE_SMTP_USER=
# FORGE_SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Identity and sessions
# ---------------------------------------------------------------------------
# Required, minimum 32 characters. Generate with:
#   openssl rand -base64 48
FORGE_SESSION_SECRET=
FORGE_SESSION_TTL=720h          # absolute session lifetime
FORGE_SESSION_IDLE_TTL=336h     # ends a session that has gone quiet
FORGE_EMAIL_VERIFY_TTL=24h
FORGE_PASSWORD_RESET_TTL=1h     # shorter: a reset link is a live credential
FORGE_MIN_PASSWORD_LENGTH=12
FORGE_MAX_SIGNIN_ATTEMPTS=8
FORGE_LOCKOUT_WINDOW=15m
# FORGE_COOKIE_SECURE defaults to true in production and cannot be disabled there
# FORGE_COOKIE_SECURE=false
# FORGE_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Model portfolio
# ---------------------------------------------------------------------------
# Qwen via Alibaba DashScope's OpenAI-compatible endpoint.
# Note: the China endpoint below and the international one
# (dashscope-intl.aliyuncs.com) issue separate keys — a key for one returns 401
# on the other.
FORGE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FORGE_LLM_API_KEY=

# What your contract with the endpoint above says about training on submitted
# content (PRD SEC-01). REQUIRED, with no default, because every default would
# be a claim nobody checked: "no_training" would have FORGE asserting a contract
# term it has never seen, and "training_opted_in" would consent on a customer's
# behalf. FORGE cannot observe what a provider does with a request; it can
# refuse to send one under terms nobody has stated.
#
#   no_training       the endpoint's terms forbid training on submitted content
#   training_opted_in the customer affirmatively opted in, and there is a record
#
# See docs/security-promises.md.
FORGE_DATA_BOUNDARY=no_training

# Roles, not one model. The verifier is deliberately a DIFFERENT model family
# from the executor: PRD SAF-03 requires high-risk conclusions be checked by a
# method independent of the one that produced them, and a model grading its own
# output is not independent. config.Load warns when these share a family.
FORGE_LLM_PLANNER_MODEL=qwen3.8-max
FORGE_LLM_EXECUTOR_MODEL=qwen3.8-max
FORGE_LLM_VERIFIER_MODEL=deepseek-v4-pro
FORGE_LLM_SUMMARIZER_MODEL=qwen3.8-flash

# The workbench conversation. Chosen for LATENCY, not depth: a person is waiting
# mid-sentence, and PRD AUD-02 asks for first audio inside 700ms. Measured on
# this provider, the deep-reasoning model took 19s to return a structured reply
# and this one took 6.8s. Neither meets the target — but routing conversation
# through the reasoning model guarantees it never will.
FORGE_LLM_CONVERSE_MODEL=qwen-plus
FORGE_LLM_REQUEST_TIMEOUT=3m
FORGE_LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# What may leave this deployment
# ---------------------------------------------------------------------------
# Which commands shell_run may execute (PRD SEC-05). An EMPTY list denies
# everything rather than permitting everything: this field existed for a long
# time with nothing setting it, so every deployment ran an unrestricted shell
# while the code read as though a control was in place. Configuration gets
# forgotten, and a forgotten line must not produce a shell that runs anything
# the host can run.
#
# FORGE does not confine network egress — a permitted command can reach any
# host this machine can reach — so this list IS the control, not a refinement
# of one. Confining egress is the deployment's job: network policy, an egress
# proxy, or no route. See docs/security-promises.md.
#
# Production refuses to start with this unset. Development warns, and every
# shell_run call is refused until it is set.
FORGE_SHELL_ALLOWED_COMMANDS=go,git,ls,cat,rg,make

# ---------------------------------------------------------------------------
# Durable execution engine
# ---------------------------------------------------------------------------
FORGE_WORKER_CONCURRENCY=4
# A claimed job stays claimed this long without a heartbeat. Too short and
# healthy long tasks get stolen; too long and a crashed worker's tasks stall.
FORGE_LEASE_DURATION=2m
FORGE_LEASE_HEARTBEAT=20s
FORGE_POLL_INTERVAL=2s
FORGE_MAX_ATTEMPTS_PER_TASK=5
FORGE_BACKOFF_BASE=2s
FORGE_BACKOFF_MAX=10m

# An agent can run away along seven axes. A bound on one is not a bound.
FORGE_MAX_ITERATIONS_PER_TASK=25
FORGE_MAX_TOOL_CALLS_PER_ITERATION=12
FORGE_MAX_TOKENS_PER_GOAL=5000000
FORGE_MAX_COST_CENTS_PER_GOAL=2000
FORGE_MAX_WALLCLOCK_PER_GOAL=720h
FORGE_MAX_TASK_DEPTH=5
FORGE_MAX_TASKS_PER_GOAL=500

# ---------------------------------------------------------------------------
# Realtime audio (PRD COL-01, AUD-03, NFR-04)
# ---------------------------------------------------------------------------
# OFF by default, and deliberately so: turning it on binds a UDP port range and
# starts accepting media. Rooms, presence and the live transcript all work
# without it — audio is an addition to the main path, not part of it — so an
# upgrade changes nothing until somebody asks for it here.
#
# Asking for audio while this is false is refused with MEDIA_DISABLED, which
# names this variable. It is not reported as a failure, because nothing failed.
FORGE_MEDIA_ENABLED=false

# The UDP ports the media plane binds. A bounded range rather than an ephemeral
# port, because a person has to open these in a firewall and "whatever the
# kernel picks" cannot be opened. The range must hold at least one port per
# participant, and startup refuses a range narrower than the room ceiling —
# otherwise it fails when the room fills and looks like a media bug.
FORGE_MEDIA_UDP_PORT_MIN=50000
FORGE_MEDIA_UDP_PORT_MAX=50200

# NFR-04's ceiling: 1-20 identified participants. A room at its ceiling refuses
# the next person with ROOM_AT_CAPACITY rather than admitting them and degrading
# for everybody already in it.
FORGE_MEDIA_MAX_PARTICIPANTS=20

# STUN/TURN servers, comma separated. Leave empty when the server is reachable
# at a routable address: it then offers host candidates, which connect fastest.
#   FORGE_MEDIA_ICE_SERVERS=stun:stun.l.google.com:19302
FORGE_MEDIA_ICE_SERVERS=

# The address to advertise in candidates when the server is behind a NAT it
# cannot discover through. Empty means advertise what is observed, which is
# correct for a directly reachable host and wrong behind one-to-one NAT.
FORGE_MEDIA_PUBLIC_IP=

# Transcription of room audio into the shared transcript (PRD AUD-03).
#
# ON by default when media is on: a room that carries audio and records nothing
# fails the requirement the room exists for. COL-01 asks for a record of who
# said what, and an untranscribed meeting has none. Separable because it calls a
# paid provider on every utterance.
FORGE_MEDIA_TRANSCRIBE=true

# How long a speaker's packets must stop before their segment is treated as a
# finished utterance. This is NOT voice activity detection — it watches packet
# arrival, not speech (internal/media/transcribe.go says why). Too short cuts
# sentences into fragments the model transcribes separately and worse; too long
# and the transcript lags the room.
FORGE_MEDIA_SILENCE_GAP=800ms

# The longest one utterance may run before it is cut and sent anyway, so a
# client that never stops sending still produces transcript. A sentence longer
# than this IS split across two turns.
FORGE_MEDIA_MAX_SEGMENT=15s

# How many segments may be at the provider at once. Sized against the room, not
# the machine: twenty people talking outrun one request at a time, and the queue
# behind this DROPS rather than blocks — a drop is lost transcript, logged at
# WARN every time.
FORGE_MEDIA_TRANSCRIBE_WORKERS=4

# The speech model. Reached through the ordinary chat endpoint, because this
# provider's OpenAI-compatible surface has no /audio/transcriptions route.
FORGE_LLM_TRANSCRIBER_MODEL=qwen3-asr-flash-2026-02-10

# FORGE's own voice in a room (PRD AUD-01, AUD-05, AUD-07).
#
# Reached through the chat endpoint with streaming, because this provider has no
# /audio/speech route and returns NO audio at all without `stream: true`.
FORGE_LLM_SPEAKER_MODEL=qwen3-omni-flash

# Which synthesised voice FORGE speaks in. One per deployment, so the character
# sounds the same in every room.
FORGE_LLM_VOICE=Cherry
