# Secrets — never commit. FORGE reads all credentials from the environment.
.env
.env.*
!.env.example
*.pem
*.key
.secrets*

# Runtime state
/.forge/
/bin/
/dist/
*.eml

# Go
*.test
*.out
coverage.*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Written by TestSpokenAudioBecomesAnAttributedTurn so the end-to-end test can
# transcribe the container the pipeline itself produced. Generated, not fixture.
internal/media/testdata/pipeline-output.ogg
eval-report.json
.cadvenv/

# Python bytecode. Rebuilt by Python on every run, tied to the interpreter version,
# and never the source of truth: a committed .pyc can disagree with the .py beside it
# and is rewritten (leaving the tree dirty) every time the kernel tests run.
__pycache__/
*.pyc
